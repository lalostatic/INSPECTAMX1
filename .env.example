# Copia a .env.local. Nunca commits de .env.
# Las secretas van en el panel del origen (Vercel/Fly) o `wrangler secret`.

# --- Públicas ---
VITE_AUTH_ENABLED=true
BETTER_AUTH_URL=https://inspectamx.com

# --- Secretas ---
DATABASE_URL=postgresql://USER:PASS@HOST/DB?sslmode=require
BETTER_AUTH_SECRET=

# --- Opcionales (broker Grok; no hace falta para email/password) ---
# GROK_AUTH_ISSUER=https://auth.grok.me
# GROK_AUTH_CLIENT_ID=
# GROK_AUTH_CLIENT_SECRET=
